#実行環境の整備に関して
ssh接続の場合:"""git clone git@github.com:yuuto1592/SE2026-T05.git"""
https接続の場合:"""git clone https://github.com/yuuto1592/SE2026-T05.git"""
このリポジトリを git clone した上で git pull した
wslの環境で以下のコードを実行してください
cd SE2026-T05
python3 -m venv .venv
source .venv/bin/activate
python3 -m pip install flask
python3 -m flask run